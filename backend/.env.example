# Copy to .env and fill in. With NONE set, SMS runs in logged-mock mode (safe for demo).

# --- core ---
PORT=3000
API_KEY=agrimesh-demo-2026
ADMIN_PASSWORD=admin123
ADMIN_TOKEN=agrimesh-admin-token

# --- SMS gateway (pick ONE; leave blank for mock) ---
# TextBee (free, needs an Android phone running the TextBee app 24/7):
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Fast2SMS (India, production, no phone; supports Hindi via unicode):
FAST2SMS_API_KEY=
