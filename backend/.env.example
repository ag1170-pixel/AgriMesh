# Copy to .env and fill in real values. Do NOT commit .env (it is gitignored).
#
# Generate strong random secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# In development, leaving ADMIN_PASSWORD unset is allowed — the server prints a
# random one-time value to the console on boot so you can still log in locally.
# In production (NODE_ENV=production) the server REFUSES to start without it.

# --- core ---
PORT=3000
NODE_ENV=development

# Public demo key sent by the frontend on /api/route and /api/sms/inbound.
# This is NOT a secret (it ships in client-side JS) — it only filters out naive
# bots. Real abuse protection is the rate limiting in middleware.js.
API_KEY=public-demo-key

# Required in production. Minimum 12 characters. Never reuse a value that has
# ever appeared in a public repo, README, or screenshot.
ADMIN_PASSWORD=

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave blank to only allow same-origin requests (recommended default).
ALLOWED_ORIGINS=

# --- SMS gateway (pick ONE; leave blank for mock) ---
# TextBee (free, needs an Android phone running the TextBee app 24/7):
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Fast2SMS (India, production, no phone; supports Hindi via unicode):
FAST2SMS_API_KEY=
